#!/bin/sh
# [pre-push] push 전에 프론트 타입체크(tsc)와 백엔드 테스트(pytest)를 돌려
# 깨진 코드가 main에 올라가는 것을 막는다.
# (실제 사고 1: 삭제된 파일이 스테일 머지로 되살아나 import가 깨진 채 push돼 main 빌드가 깨짐)
# (실제 사고 2: 타입체크만 돌던 시절, Postgres 전용 SQL 함수를 써서 테스트 7건이
#  깨진 커밋이 그대로 push됨 — 그래서 백엔드 테스트를 여기에 함께 걸었다)
# 무거운 검사라 매 커밋이 아니라 push 시점에만 돈다.

ROOT="$(git rev-parse --show-toplevel)"

# --- 1) 프론트 타입체크 ---
if [ -x "$ROOT/frontend/node_modules/.bin/tsc" ]; then
  echo "▶ pre-push: 프론트 타입체크 중… (tsc --noEmit)"
  if ! (cd "$ROOT/frontend" && node_modules/.bin/tsc --noEmit); then
    echo ""
    echo "✖ push 거부: 프론트 타입 에러가 있습니다. 위 오류를 고친 뒤 다시 push하세요."
    echo "  (긴급 시 우회: git push --no-verify)"
    exit 1
  fi
  echo "✓ 타입체크 통과"
else
  echo "⚠ pre-push: frontend에 typescript가 없어 타입체크를 건너뜁니다 (npm install 권장)."
fi

# --- 2) 백엔드 테스트 ---
# 테스트는 conftest가 로컬 SQLite로 돌려놓으므로 운영 DB를 건드리지 않는다.
PY="$ROOT/backend/.venv/bin/python"
if [ -x "$PY" ]; then
  echo "▶ pre-push: 백엔드 테스트 중… (pytest -q)"
  if ! (cd "$ROOT/backend" && "$PY" -m pytest tests/ -q); then
    echo ""
    echo "✖ push 거부: 백엔드 테스트가 실패했습니다. 위 출력을 확인하세요."
    echo "  (긴급 시 우회: git push --no-verify)"
    exit 1
  fi
  echo "✓ 백엔드 테스트 통과 — push 진행"
else
  echo "⚠ pre-push: backend/.venv가 없어 테스트를 건너뜁니다."
fi

exit 0
