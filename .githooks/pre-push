#!/bin/sh
# [pre-push] push 전에 프론트 타입체크(tsc)를 돌려 빌드가 깨진 코드가 main에 올라가는 것을 막는다.
# (실제 사고: 삭제된 파일이 스테일 머지로 되살아나 import가 깨진 채 push돼 main 빌드가 깨진 일이 반복됨)
# 무거운 검사라 매 커밋이 아니라 push 시점에만 돈다.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/frontend" 2>/dev/null || exit 0

if [ ! -x node_modules/.bin/tsc ]; then
  echo "⚠ pre-push: frontend에 typescript가 없어 타입체크를 건너뜁니다 (npm install 권장)."
  exit 0
fi

echo "▶ pre-push: 프론트 타입체크 중… (npx tsc --noEmit)"
if ! node_modules/.bin/tsc --noEmit; then
  echo ""
  echo "✖ push 거부: 프론트 타입 에러가 있습니다. 위 오류를 고친 뒤 다시 push하세요."
  echo "  (긴급 시 우회: git push --no-verify)"
  exit 1
fi

echo "✓ 타입체크 통과 — push 진행"
exit 0
