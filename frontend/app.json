{
  "expo": {
    "name": "브루노트",
    "slug": "frontend",
    "scheme": "simplem",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/brew_icon_cutout.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vivayouth.brewnote"
    },
    "android": {
      "package": "com.vivayouth.brewnote",
      "adaptiveIcon": {
        "backgroundColor": "#FBEFDD",
        "foregroundImage": "./assets/brew_icon_cutout.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/brew_icon_cutout.png"
    },
    "updates": {
      "url": "https://u.expo.dev/c52a42c6-f4ce-40d9-8f65-ace86953424b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성 명령을 듣기 위해 마이크를 사용합니다.",
          "speechRecognitionPermission": "말씀하신 내용을 텍스트로 바꾸기 위해 음성 인식을 사용합니다."
        }
      ],
      "expo-web-browser",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "매장 센서(무게·온도·RFID 허브)를 찾기 위해 블루투스를 사용합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brew_icon_cutout.png",
          "color": "#E8833A",
          "defaultChannel": "brewnote-default"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "관심사에 맞는 광고를 보여드리기 위해 기기 식별자를 사용합니다.",
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c52a42c6-f4ce-40d9-8f65-ace86953424b"
      }
    }
  }
}
