# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.sqlite3
.pytest_cache/
.mypy_cache/

# OCR 업로드 원본 (백엔드 B)
backend/uploads/

# ML
*.pkl
*.joblib
ml/models/

# Node / Next.js
node_modules/
.next/
out/
frontend/.env*
!frontend/.env.example
# 배포 웹 빌드용 — EXPO_PUBLIC_* 공개값만 담으므로 커밋 대상
!frontend/.env.production

# Cloud Run 배포 환경변수 (실제 시크릿 — 커밋 금지, 예시는 env.example.yaml)
backend/deploy/env.yaml
# GCP 서비스 계정 키 (GitHub Secrets 등록용 — 절대 커밋 금지)
backend/deploy/github-deployer-key.json
# FCM 발송용 서비스 계정 키 (절대 커밋 금지 — 이 키 하나로 전 사용자에게 푸시를 쏠 수 있다)
# 서버에는 FCM_SERVICE_ACCOUNT_JSON 환경변수로 넣는다.
# 참고: frontend/google-services.json은 비밀이 아니라 앱 번들에 포함되는 값이므로 커밋 대상이다
#      (EAS 빌드가 app.json의 android.googleServicesFile 경로에서 찾는다).
**/serviceAccountKey*.json
**/firebase-adminsdk-*.json
# 로컬 개발용 키 보관 위치 (.env의 GOOGLE_APPLICATION_CREDENTIALS가 가리킨다).
# 파일명이 위 규칙에 안 맞게 바뀌어도 새 나가지 않도록 디렉터리째 막는다.
backend/secrets/

# IDE / OS
.vscode/
.idea/
# Claude Code 로컬 권한 설정 (개인 승인 이력 + 절대 경로 — 공유 대상 아님)
.claude/settings.local.json
.DS_Store
Thumbs.db
backend/simplem.db
sensor_pairing.json

# APK 배포물은 서버 static에만 둔다 (git에 105MB 바이너리 금지)
*.apk
backend/uvicorn_restart.log

# TLS 인증서/개인키 (tailscale cert 산출물 — 절대 커밋 금지)
*.crt
*.key

# 원두 사이트 정찰 스크립트가 저장하는 HTML 덤프 (재생성 가능, 용량 큼)
backend/scripts/_recon/

# 벡터 스토어 로컬 데이터 (원두 리뷰 RAG · chromadb) — 바이너리 세그먼트라 커밋 금지
backend/data/chroma_db/
