{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-web-attach",
      "url": "http://localhost:8081"
    },
    {
      "name": "web-dist-sim",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist", "-s", "-l", "8099"],
      "cwd": "frontend",
      "port": 8099
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "frontend-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081", "--clear"],
      "cwd": "frontend",
      "port": 8081
    }
  ]
}
